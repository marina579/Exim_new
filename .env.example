# EXIM Contact Enricher - Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# Flask Secret Key (REQUIRED - generate a strong random key)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-a-random-one

# OpenAI API (REQUIRED for ChatGPT enrichment)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# SerpAPI (REQUIRED for Google Maps/Search)
SERPAPI_API_KEY=your-serpapi-key-here

# Gemini API (OPTIONAL - for paid mode enrichment)
GEMINI_API_KEY=AIzaSy-your-gemini-key-here

# Zoho CRM Integration (OPTIONAL but recommended)
ZOHO_CLIENT_ID=1000.your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=1000.your-zoho-refresh-token
ZOHO_DATA_CENTER=com
# Options: 'com' for US, 'in' for India, 'eu' for Europe

# Database (OPTIONAL - uses SQLite if not set)
# Railway/Heroku provide this automatically for PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Auto-push to Zoho (OPTIONAL - default: true)
AUTO_PUSH_TO_ZOHO=true
# Set to 'false' to disable automatic Zoho push during upload

# Flask Debug Mode (OPTIONAL - set to false in production)
FLASK_DEBUG=false
